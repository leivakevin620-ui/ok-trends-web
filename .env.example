# Public Supabase configuration (safe to expose in the browser only when RLS is enabled)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets. Never commit real values.
SUPABASE_SERVICE_ROLE_KEY=

# Store configuration
NEXT_PUBLIC_STORE_NAME=O&K Trends
NEXT_PUBLIC_STORE_CITY=Santa Marta
NEXT_PUBLIC_STORE_COUNTRY=Colombia
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Optional AI provider. Leave empty while using simulation mode.
AI_PROVIDER=simulation
OPENAI_API_KEY=

# Optional automation webhook. Use only an authenticated n8n webhook.
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
