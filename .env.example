# Public Supabase configuration. Publishable values are safe only with RLS enabled.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase secret. Reserved for trusted maintenance jobs; never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Temporary owner bootstrap access.
# Password: minimum 12 characters. Session secret: minimum 32 random characters.
# This mechanism is disabled when either value is empty and will be replaced by Supabase Auth.
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_SESSION_SECRET=

# Store configuration
NEXT_PUBLIC_STORE_NAME=O&K Trends
NEXT_PUBLIC_STORE_CITY=Santa Marta
NEXT_PUBLIC_STORE_COUNTRY=Colombia
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Optional AI provider. Leave in simulation mode until an approved provider is configured.
AI_PROVIDER=simulation
OPENAI_API_KEY=

# Optional automation webhook. Use only an authenticated n8n webhook.
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
